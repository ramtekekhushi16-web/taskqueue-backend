ENVIRONMENT=development
POSTGRES_DB=taskqueue
POSTGRES_USER=taskqueue
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
WORKER_ID=worker-1
